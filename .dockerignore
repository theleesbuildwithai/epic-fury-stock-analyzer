# Secrets — never bake into the image
.env
**/.env
*.pem
*.key

# Local databases / portfolio state (restored from S3 at runtime, not baked in)
*.db
*.db*
*.sqlite

# Local-only runtime state flag files (must not ship in the image)
**/.cash_adj_done
**/.cash_recovery_*_done
**/.portfolio_reset_*_done
**/.daily_pause_clear_*_done
**/.fund_inception_date
**/.sp500_disk_cache.json

# Python caches / build artifacts
**/__pycache__/
**/*.pyc
**/*.pyo

# Node / frontend build artifacts (frontend is rebuilt inside the image)
frontend/node_modules/
frontend/dist/

# VCS / OS / editor cruft
.git/
.gitignore
.DS_Store
*.log
